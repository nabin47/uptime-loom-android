<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own device backup / phone-to-phone transfer may include your
     history so it survives a phone change. The app itself never uploads it. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
